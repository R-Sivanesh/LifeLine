# Google Gemini Dispatcher AI (Backend only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google Maps Platform (Live Traffic Routes & Places Discovery)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_ROUTES_API_KEY=your_google_maps_api_key_here
GOOGLE_PLACES_API_KEY=your_google_maps_api_key_here

# Firebase Realtime Database (Real-time Live Ambulance GPS Tracking)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Frontend Map Client Key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

DATABASE_URL=
FRONTEND_URL=http://localhost:5173
DEMO_MODE=true
